# --- Database (required) ---------------------------------------------------------------
# DATABASE_URL is what the app uses; DIRECT_URL is used by Prisma Migrate, which needs a
# direct (non-pooled) connection. The defaults are the local database that
# `npm run db:dev` runs; for any plain Postgres, set both to the same URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/syncspace"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/syncspace"

# On Neon (production, set on Render): DATABASE_URL is the *pooled* string (its host
# contains "-pooler") and DIRECT_URL is the same string without "-pooler".
# connect_timeout=15 gives a sleeping Neon database time to wake up on the first query.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15"

# --- Server -----------------------------------------------------------------------------
PORT=4000
# Browser origin(s) of the web app, comma-separated.
CLIENT_ORIGIN="http://localhost:3000"
# How many proxies sit in front of the server (decides req.ip for rate limits).
# TRUST_PROXY=1

# --- Quiz generation (optional) ---------------------------------------------------------
# With a key, Claude writes the quizzes; without one, the built-in generator does.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# QUIZ_GENERATOR=auto   # auto | llm | heuristic

# --- Tests ------------------------------------------------------------------------------
# `npm test` starts its own embedded Postgres and never reads DATABASE_URL. To test against
# an existing database instead (e.g. in CI), set TEST_DATABASE_URL. Never point it at real data.
# TEST_DATABASE_URL=
